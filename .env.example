# Copier en .env (jamais commité) puis remplir. Chaque variable est documentée.

# --- Environnement : dev | prod (P4 — la prod n'est utilisée que par la CI)
ALTISPORT_ENV=dev

# --- Databricks (brique 4+)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse_id>
DATABRICKS_TOKEN=<personal-access-token>

# --- AWS (brique 3+) — préférer un profil nommé à des clés en clair
AWS_PROFILE=altisport-dev
AWS_REGION=eu-west-3
ALTISPORT_S3_BUCKET=<nom-du-bucket>
